# NetMedic reproducible build environment (P1.5).
#
# Pins the OS + system deps + Python packages so `dist/netmedic` is identical
# regardless of the host. CI `container-build` should migrate to this image.
#
# Base is ubuntu:24.04 (noble): it ships python3.12 and
# libgirepository-2.0-dev natively. ubuntu:22.04 (jammy) has neither
# (no python3.12, gir is libgirepository1.0-dev) — do not downgrade
# without adding deadsnakes + renaming the gir dev package.
#
#   docker build -f Dockerfile.build -t netmedic-build:1.6 .
#   docker run --rm -v "$PWD/dist:/out" netmedic-build:1.6
#
# The binary is extracted to ./dist on the host; nothing else leaves the image.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-venv python3-pip libpython3.12 \
    python3-gi python3-gi-cairo gir1.2-gtk-3.0 \
    libcairo2-dev libgirepository-2.0-dev pkg-config \
    binutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY requirements.lock requirements-dev.lock ./
COPY netmedic/ ./netmedic/
COPY netmedic_ai/ ./netmedic_ai/
COPY assets/ ./assets/
COPY docs/MANUAL.md ./docs/MANUAL.md
COPY scripts/build_binary.sh ./scripts/build_binary.sh
COPY netmedic.spec ./

# NOTE: PyGObject comes from apt (python3-gi), not pip — PyPI sdist would
# need a C toolchain (meson/gcc) inside the image.
# M6: binary inputs install ONLY from the hash-pinned lock
# (--require-hashes); unpinned `pip install` on the runner is banned for
# shipped artifacts. Lock scope (cp312 manylinux) matches this image.
# --system-site-packages exposes apt's gi to the venv.
RUN python3.12 -m venv --system-site-packages /opt/buildenv \
    && /opt/buildenv/bin/pip install --upgrade pip wheel setuptools \
    && /opt/buildenv/bin/pip install --require-hashes -r requirements.lock \
    && /opt/buildenv/bin/pip install --no-deps -e netmedic/ \
    && ln -s /opt/buildenv /src/venv

RUN chmod +x scripts/build_binary.sh \
    && PATH="/opt/buildenv/bin:$PATH" ./scripts/build_binary.sh \
    && test -f dist/netmedic \
    && sha256sum dist/netmedic | tee dist/netmedic.sha256

# Default: print the artifact hash (override with a bind mount to extract).
CMD ["cat", "dist/netmedic.sha256"]
